{
  "manifest_version": 3,
  "name": "URL Prefix Blocker",
  "version": "1.0.0",
  "description": "Block pages whose URL starts with a prefix from your list.",
  "permissions": ["storage", "tabs", "webNavigation"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "URL Prefix Blocker"
  }
}
